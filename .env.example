# Copie este arquivo para .env e preencha as chaves. O .env não vai para o git.

# Transcrição com identificação de falantes (https://www.assemblyai.com/dashboard).
# Sem ela, o app usa o Whisper local, sem falantes.
ASSEMBLYAI_API_KEY=

# Organização por pautas: o jeito mais fácil é escolher a IA no painel "IA das pautas",
# no topo da página (a escolha e a chave ficam em ia_config.json, fora do git).
# Se preferir, deixe a chave aqui; ela vale como padrão para o provedor correspondente.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Opcionais
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# FFMPEG_DIR=C:\caminho\para\ffmpeg\bin
